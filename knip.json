{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "api/render-pdf.ts",
    "src/App.tsx",
    "src/**/*.test.tsx"
  ],
  "project": [
    "api/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "types"
  ],
  "ignoreDependencies": [
    "eslint",
    "supabase"
  ],
  "ignoreBinaries": [
    "eslint",
    "knip",
    "madge",
    "supabase",
    "tsc",
    "vite",
    "vitest"
  ],
  "ignoreIssues": {
    "src/integrations/supabase/types.ts": [
      "exports"
    ]
  }
}
